{
  "routes": [
    {
      "route": "/api/whatsapp",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/confirm",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/cron/tick",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/calls/result",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/privacy.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/.auth/*",
      "/privacy.html"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
