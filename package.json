{
  "name": "tcmpl-ai-onboarding-react-enterprise",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js api/test/*.test.js",
    "build": "vite build",
